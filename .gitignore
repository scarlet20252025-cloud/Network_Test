# 运行期状态（含凭据/备份/截图），不入库
tools/.borrow-net/
*.log
*.pid
borrow-net.keeper.lock
proxy-backup.txt

# 真实密钥配置（只入库 .example）
config/wg0-remote.conf
config/wg0-local.conf
.commitmsg.txt

# 用户库含明文令牌，绝不入库
users.json
client-configs/
.proxy-state/

# 误提交的客户端二进制（0.9.5 曾漏进来一次）
渡口助手-*.exe
Ferry-Setup-*.exe

# 临时测试/调试文件
scratch/
portal/portal.db
portal/portal-admin.txt
portal/test-portal.db
portal/out.log
portal/err.log
portal/*.db
portal/*.db-*
.ferry/
portal/ck*.txt
__pycache__/
*.pyc
*.keeper.lock

# 构建产物（安装包 2 MB 一个版本，不入库；需要时用 ISCC 重编）
dist/

# 代码签名私钥 —— 绝不入库（公钥 .cer 可以）
installer/ferry-sign.pfx

# 客户端测试程序的编译产物
ferry-client/test/out/

# WireGuard 客户端私钥 —— 绝不入库
wireguard/*.key

# mihomo 统一入口的运行期产物（模板 config.template.yaml 才入库）
mihomo/config.yaml
mihomo/cache.db
mihomo/mihomo-state.txt
mihomo/*.lock
mihomo/*.pid
mihomo/wintun.dll

# 第三方二进制（61 MB），不入库。用 tools/fetch-vendor.ps1 现取。
# 但 wintun.dll 例外 —— 它只有 418 KB，而且版本必须和 mihomo 配套，
# 单独下载容易拿错版本。mihomo/ 目录里那份随代码一起入库。
vendor/*.exe
vendor/*.zip

versions/

# ── Android ──
# 构建中间产物不进球
android/**/build/
android/.gradle/
android/.idea/
android/local.properties

# 参考源码：本地只用来查实现，体积大且自带 .git
android/third-part/hev-socks5-tunnel/

# jniLibs 里的 .so **要**入库（约 580 KB）——
# 它决定「clone 下来能不能直接出包」。重编要 NDK + 四个子模块，代价太大。
# 保留：android/app/src/main/jniLibs/**

# 但任何 .so 的调试符号/中间文件都不要
android/**/*.so.dbg
android/**/obj/

