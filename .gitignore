# 运行期状态（含凭据/备份/截图），不入库
tools/.borrow-net/
*.log
*.pid
borrow-net.keeper.lock
proxy-backup.txt

# 真实密钥配置（只入库 .example）
config/wg0-remote.conf
config/wg0-local.conf
.commitmsg.txt

# 用户库含明文令牌，绝不入库
users.json
client-configs/
.proxy-state/

# 临时测试/调试文件
scratch/
portal/portal.db
portal/portal-admin.txt
portal/test-portal.db
portal/out.log
portal/err.log
portal/*.db
portal/*.db-*
.ferry/
portal/ck*.txt
__pycache__/
*.pyc
*.keeper.lock

# 构建产物（安装包 2 MB 一个版本，不入库；需要时用 ISCC 重编）
dist/

# 代码签名私钥 —— 绝不入库（公钥 .cer 可以）
installer/ferry-sign.pfx

# 客户端测试程序的编译产物
ferry-client/test/out/

# WireGuard 客户端私钥 —— 绝不入库
wireguard/*.key

# mihomo 统一入口的运行期产物（模板 config.template.yaml 才入库）
mihomo/config.yaml
mihomo/cache.db
mihomo/mihomo-state.txt
mihomo/*.lock
# wintun.dll 是第三方二进制（427 KB），现阶段 TUN 用不上（需管理员）。
# 真要用时从 C:\Users\<你>\AppData\Local\easytier-gui\wintun.dll 拷过来。
mihomo/wintun.dll

versions/
