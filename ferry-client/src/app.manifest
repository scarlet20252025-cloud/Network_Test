<?xml version="1.0" encoding="utf-8"?>
<!--
  渡口 Ferry 客户端 manifest

  为什么需要它：
    TUN 模式要在网络层接管全局流量，必须创建虚拟网卡 + 改路由表，
    这要求管理员权限。没有 manifest 的话，用户得手动「右键 → 以管理员身份运行」，
    而且从桌面快捷方式启动时那个选项不生效 —— 用户体验很差。

  为什么是 asInvoker（0.9.6 起）：
    0.9.5 之前是 requireAdministrator，代价有三个，每个都真被打到过：
      · 每次启动弹 UAC
      · 安装器 [Run] 用 CreateProcess 启动时报「错误代码 740」
      · 标准用户（没有管理员账户密码）根本用不了，而纯代理模式其实不需要提权
    改系统代理是写 HKCU、起子进程，都不需要管理员。
    只有 TUN（建虚拟网卡 + 改路由表）必须提权 —— 那时由客户端自己
    `runas` 重启一次（见 src/Elevator.cs），用户点一次 UAC 就行。
    新装默认 useTun=false，所以绝大多数人永远见不到 UAC。

  dpiAware / dpiAwareness：
    WinForms 在高 DPI 下不声明就会模糊。PerMonitorV2 是 Win10 1703+ 的标准做法。
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Ferry.Client" type="win32" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
      <!-- 长路径支持：安装目录可能被放到很深的路径下 -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
