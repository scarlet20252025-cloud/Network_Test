<?xml version="1.0" encoding="utf-8"?>
<!--
  输入框背景：白底 + 浅灰描边 + 圆角。

  为什么不用主题默认背景：2026-10-29 用户报「激活码输入框看不见、
  输入后也不显示文字」。根因是主题用了 DayNight，而配色只定义了浅色一套
  （没有 values-night），系统处于深色模式时 Material 会把文字变成浅色，
  而卡片背景是写死的白色 —— 浅色字画在白底上，等于隐身。

  所以这里的策略是：**不依赖任何主题属性**，颜色和描边全部写死。
  这样以后即使有人把主题改回 DayNight，输入框也不会再消失。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#C9D4CF" />
    <corners android:radius="8dp" />
</shape>
