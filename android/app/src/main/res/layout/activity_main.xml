<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ferry_bg"
    android:padding="16dp">

    <!-- 状态卡 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/ferry_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/state_off"
                android:textColor="@color/ferry_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ferry_text_muted"
                android:textSize="13sp"
                android:text="尚未激活" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_start"
                android:textSize="16sp"
                app:backgroundTint="@color/ferry_accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelfCheck"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_selfcheck"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 激活卡：两种形态切换
         未激活 → 显示输入框 + 激活按钮
         已激活 → 隐藏输入框，显示「已激活 + 剩余天数 + 到期日期」
         （用户要求对齐 PC 端：PC 上就是「剩余 27 天 · 2026-11-25 到期」） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardActivate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/ferry_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardState">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtActivateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_code"
                android:textColor="@color/ferry_text"
                android:textSize="14sp" />

            <!-- 未激活形态 -->
            <LinearLayout
                android:id="@+id/rowInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!--
                  输入框的三处显式设置都是必要的（2026-10-29 真机 bug）：
                    · background  —— 主题默认背景在这套配色下等于没有，看不出哪里能点
                    · textColor    —— 不设就吃主题默认，深色模式下是浅色字，白底上隐身
                    · textColorHint—— 同上，hint 也会隐身
                  另外 inputType 用 textCapCharacters：门户那边会 .upper()，
                  客户端直接大写更直观；不要连字符（门户只收 6–16 位字母数字）。
                -->
                <EditText
                    android:id="@+id/txtCode"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_code"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="16"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/ferry_text"
                    android:textColorHint="@color/ferry_text_muted"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActivate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_activate"
                    app:backgroundTint="@color/ferry_accent" />
            </LinearLayout>

            <!-- 已激活形态 -->
            <LinearLayout
                android:id="@+id/boxActivated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtActivationInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ferry_good"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="已激活 · 剩余 23 小时 · 2026-10-30 到期" />

                <TextView
                    android:id="@+id/txtActivationSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ferry_text_muted"
                    android:textSize="12sp"
                    tools:text="vivo V1824A · 设备 1/3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangeCode"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-8dp"
                    android:layout_marginTop="4dp"
                    android:minHeight="36dp"
                    android:text="@string/btn_change_code"
                    android:textColor="@color/ferry_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 日志 -->
    <TextView
        android:id="@+id/txtLogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:text="@string/label_log"
        android:textColor="@color/ferry_text_muted"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardActivate" />

    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtLogTitle">

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ferry_card"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/ferry_text"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
